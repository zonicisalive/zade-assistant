[Unit]
Description=Zade voice assistant
# Start with the desktop session: before login there is no audio session, so the microphone is missing.
PartOf=graphical-session.target
After=graphical-session.target pipewire.service wireplumber.service pipewire-pulse.service
Wants=pipewire.service wireplumber.service

[Service]
ExecStart=%h/Zade/.venv/bin/zade
Restart=on-failure
RestartSec=5
EnvironmentFile=-%h/.config/zade/env
# Never swapped out: the replay buffer (audio, and the screen's chunks in /dev/shm) must stay in RAM,
# never be written to the disk's swap.
MemorySwapMax=0

[Install]
WantedBy=graphical-session.target
