[Unit]
Description=Zade speech recognition (whisper.cpp large-v3-turbo on the GPU via Vulkan, ~1.1 GB VRAM)
# Build: see README ("GPU speech recognition"). Zade starts this when it listens and stops it after
# stt.keep_alive_s idle; it falls back to its CPU model when this isn't running.

[Service]
ExecStart=%h/.local/share/zade/whisper.cpp/build/bin/whisper-server -m %h/.local/share/zade/whisper.cpp/models/ggml-large-v3-turbo-q8_0.bin --host 127.0.0.1 --port 8178 -l en
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
