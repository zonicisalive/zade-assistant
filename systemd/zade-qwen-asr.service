[Unit]
Description=Zade speech recognition (Qwen3-ASR-0.6B via llama.cpp on the GPU through Vulkan, ~0.8 GB VRAM)
# Stopping Zade stops this too, so its VRAM is freed (a restart doesn't start it early).
StopPropagatedFrom=zade.service
# Build: see README ("Qwen3-ASR"). Zade starts this when it listens and stops it after stt.keep_alive_s
# idle; it falls back to its CPU model when this isn't running.

[Service]
# Room for one request of up to 60 s (Zade's longest), an 8-bit cache and the small audio encoder on the CPU:
# 0.8 GB of VRAM instead of 2.0, the same transcripts, +70 ms on a short request.
ExecStart=%h/.local/share/zade/llama.cpp/build/bin/llama-server -m %h/.local/share/zade/qwen3-asr/Qwen3-ASR-0.6B-Q8_0.gguf --mmproj %h/.local/share/zade/qwen3-asr/mmproj-Qwen3-ASR-0.6B-Q8_0.gguf --host 127.0.0.1 --port 8182 -ngl 99 -c 3072 -np 1 -fa on -ctk q8_0 -ctv q8_0 --no-mmproj-offload
Restart=on-failure
RestartSec=5
